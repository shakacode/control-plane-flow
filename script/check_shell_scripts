#!/usr/bin/env bash
set -euo pipefail

repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

if ! command -v shellcheck >/dev/null 2>&1; then
  echo "ShellCheck is required; install it and ensure shellcheck is on PATH." >&2
  exit 127
fi

shell_files=()

while IFS= read -r -d '' entry; do
  metadata=${entry%%$'\t'*}
  file=${entry#*$'\t'}
  mode=${metadata%% *}

  case "$file" in
    *.sh|*.bash)
      if [ ! -r "$file" ]; then
        echo "Tracked shell script is not readable: $file" >&2
        exit 1
      fi
      shell_files+=("$file")
      continue
      ;;
  esac

  [ "$mode" = "100755" ] || continue
  if [ ! -r "$file" ]; then
    echo "Tracked executable is not readable: $file" >&2
    exit 1
  fi
  first_line=''
  IFS= read -r first_line < <(LC_ALL=C head -c 4096 -- "$file") || true
  first_line=${first_line%$'\r'}

  if [[ $first_line =~ ^'#!'.*/(sh|bash)([[:space:]].*)?$ ]] ||
     [[ $first_line =~ ^'#!'.*/env[[:space:]]+(.*/)?(sh|bash)([[:space:]].*)?$ ]]; then
    shell_files+=("$file")
  elif [[ $first_line =~ ^'#!'.*/env[[:space:]]+-S[[:space:]]*(.*/)?(sh|bash)([[:space:]].*)?$ ]] ||
       [[ $first_line =~ ^'#!'.*/env[[:space:]]+--split-string=(.*/)?(sh|bash)([[:space:]].*)?$ ]]; then
    shell_files+=("$file")
  elif [[ $first_line =~ ^'#!'.*/env[[:space:]]+(-S[[:space:]]+|--split-string=)?((-[^[:space:]]+|[^[:space:]=]+=[^[:space:]]*)[[:space:]]+)+(.*/)?(sh|bash)([[:space:]].*)?$ ]]; then
    echo "Unsupported env-prefixed shebang in tracked executable: $file" >&2
    exit 1
  fi
done < <(git ls-files --stage -z)

if [ "${#shell_files[@]}" -eq 0 ]; then
  echo "No tracked shell scripts found." >&2
  exit 1
fi

exec shellcheck -- "${shell_files[@]}"
