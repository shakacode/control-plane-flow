#!/usr/bin/env bash
set -euo pipefail

repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

if ! command -v shellcheck >/dev/null 2>&1; then
  echo "ShellCheck is required; install it and ensure shellcheck is on PATH." >&2
  exit 127
fi

shell_files=()
env_words=()
split_words=()

is_env_assignment() {
  [[ $1 == *=* ]] || return 1
}

parse_env_short_options() {
  local options=${1#-}
  local option

  env_option_value_kind='none'
  env_option_value=''
  while [ -n "$options" ]; do
    option=${options:0:1}
    options=${options:1}
    case "$option" in
      i|v)
        ;;
      a|u|C|P)
        env_option_value_kind='skip'
        env_option_value=$options
        return 0
        ;;
      S)
        env_option_value_kind='split'
        env_option_value=$options
        return 0
        ;;
      *)
        return 1
        ;;
    esac
  done
}

split_env_string() {
  local env_string=$1
  local sentinel=__CPFLOW_ENV_SPLIT_START__
  local word

  split_words=()
  while IFS= read -r -d '' word; do
    split_words+=("$word")
  done < <(/usr/bin/env -S "/usr/bin/printf '%s\\0' $sentinel $env_string" 2>/dev/null)

  [ "${#split_words[@]}" -gt 0 ] || return 1
  [ "${split_words[0]}" = "$sentinel" ] || return 1
  if [ "${#split_words[@]}" -gt 1 ]; then
    split_words=("${split_words[@]:1}")
  else
    split_words=()
  fi
}

is_env_shell_command() {
  local env_string=$1
  local options=true
  local split_count=0
  local word
  local env_option_value_kind='none'
  local env_option_value=''

  split_env_string "$env_string" || return 1
  env_words=("${split_words[@]}")

  # Expand nested env split-string options without executing the discovered command.
  while [ "${#env_words[@]}" -gt 0 ]; do
    word=${env_words[0]}
    env_words=("${env_words[@]:1}")
    env_option_value_kind='none'
    env_option_value=''

    if [ "$options" = true ]; then
      case "$word" in
        --)
          options=false
          continue
          ;;
        --argv0|--unset|--chdir)
          [ "${#env_words[@]}" -gt 0 ] || return 1
          env_words=("${env_words[@]:1}")
          continue
          ;;
        --split-string)
          [ "${#env_words[@]}" -gt 0 ] || return 1
          env_option_value_kind='split'
          env_option_value=${env_words[0]}
          env_words=("${env_words[@]:1}")
          ;;
        --split-string=*)
          env_option_value_kind='split'
          env_option_value=${word#*=}
          ;;
        -|--argv0=*|--unset=*|--chdir=*|--ignore-environment|--debug|--block-signal|--block-signal=*|--default-signal|--default-signal=*|--ignore-signal|--ignore-signal=*|--list-signal-handling)
          continue
          ;;
        -*)
          if parse_env_short_options "$word"; then
            case "$env_option_value_kind" in
              none)
                continue
                ;;
              skip)
                if [ -z "$env_option_value" ]; then
                  [ "${#env_words[@]}" -gt 0 ] || return 1
                  env_words=("${env_words[@]:1}")
                fi
                continue
                ;;
              split)
                if [ -z "$env_option_value" ]; then
                  [ "${#env_words[@]}" -gt 0 ] || return 1
                  env_option_value=${env_words[0]}
                  env_words=("${env_words[@]:1}")
                fi
                ;;
            esac
          else
            return 1
          fi
          ;;
      esac

      if [ "$env_option_value_kind" = 'split' ]; then
        split_count=$((split_count + 1))
        [ "$split_count" -le 32 ] || return 1
        split_env_string "$env_option_value" || return 1
        if [ "${#split_words[@]}" -gt 0 ]; then
          if [ "${#env_words[@]}" -gt 0 ]; then
            env_words=("${split_words[@]}" "${env_words[@]}")
          else
            env_words=("${split_words[@]}")
          fi
        fi
        env_option_value=''
        continue
      fi
    fi

    if is_env_assignment "$word"; then
      options=false
      continue
    fi

    case "$word" in
      sh|bash|*/sh|*/bash)
        return 0
        ;;
      *)
        return 1
        ;;
    esac
  done

  return 1
}

while IFS= read -r -d '' entry; do
  metadata=${entry%%$'\t'*}
  file=${entry#*$'\t'}
  mode=${metadata%% *}

  case "$file" in
    *.sh|*.bash)
      [ -r "$file" ] && shell_files+=("$file")
      continue
      ;;
  esac

  [ "$mode" = "100755" ] || continue
  first_line=''
  IFS= read -r first_line < "$file" || true
  first_line=${first_line%$'\r'}
  case "$first_line" in
    '#!'*/sh|'#!'*/sh\ *|'#!'*/bash|'#!'*/bash\ *|'#!/usr/bin/env sh'|'#!/usr/bin/env sh '*|'#!/usr/bin/env bash'|'#!/usr/bin/env bash '*)
      shell_files+=("$file")
      ;;
    '#!/usr/bin/env -S'?*)
      env_string=${first_line#'#!/usr/bin/env -S'}
      is_env_shell_command "${env_string# }" && shell_files+=("$file")
      ;;
  esac
done < <(git ls-files --stage -z)

if [ "${#shell_files[@]}" -eq 0 ]; then
  echo "No tracked shell scripts found." >&2
  exit 1
fi

exec shellcheck -- "${shell_files[@]}"
